Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Landmarks1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Global Options:
    Background Color: 34; 36; 41
    Fixed Frame: map
    Frame Rate: 30

  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 70; 74; 82

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Alpha: 1

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        # Best-effort to match the sensor QoS the driver publishes with. A
        # reliable subscriber never connects to a best-effort publisher, and
        # RViz shows nothing with no error - the most common "my lidar is
        # broken" that is actually a QoS mismatch.
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.04
      Style: Points
      Color: 255; 170; 40
      Color Transformer: FlatColor

    - Class: rviz_default_plugins/MarkerArray
      Name: Landmarks
      Enabled: true
      Topic:
        Value: /landmarks
        Durability Policy: Transient Local
      Namespaces:
        {}

    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 60; 200; 160
      Line Style: Lines

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
      Color: 240; 100; 100
      Line Style: Lines

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.4

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 18
      Focal Point:
        X: 6
        Y: 4.5
        Z: 0
      Pitch: 1.1
      Yaw: 1.57

Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
