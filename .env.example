# Optional. The robot navigates, patrols, docks and stops without this.
# Setting it only widens the range of phrasings the grounder understands.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative: a path to a file containing the key, for setups that mount
# secrets rather than passing environment variables.
# GEMINI_API_KEY_FILE=/run/secrets/gemini
